# Copie ce fichier en `.env` et adapte-le. Tout est facultatif : les valeurs ci-dessous sont les valeurs par défaut.

# Phrase secrète qui chiffre les sessions wiki-pick des joueurs au repos. Choisis-en une longue et garde-la :
# la perdre oblige simplement chacun à se reconnecter. Si elle est vide, une clé est générée dans le dossier de données.
ALTWP_SECRET=

# Cookie réservé à HTTPS. À laisser à 1 en production ; 0 seulement pour un essai en HTTP hors localhost.
ALTWP_COOKIE_SECURE=1

# Derrière un reverse proxy (Caddy, nginx…) : 1, pour lire la vraie adresse du visiteur (limites de débit par adresse).
# Sans proxy : 0 (sinon n'importe qui pourrait tricher sur son adresse).
ALTWP_TRUST_PROXY=0

# Qui peut se connecter : un nombre maximum de comptes wiki-pick (0 = illimité), et/ou une liste blanche de pseudos.
# Chaque joueur connecté ajoute une connexion vers wiki-pick.com : reste raisonnable.
ALTWP_MAX_USERS=20
ALTWP_ALLOWED_USERS=

# Durée d'une session de l'appli (glissante, en jours), et appels autorisés par minute et par joueur.
ALTWP_SESSION_DAYS=30
ALTWP_RPC_PER_MINUTE=240

# Identifiant envoyé à wiki-pick.com. Par défaut, il dit honnêtement qu'il s'agit d'Alt-WikiPick.
ALTWP_USER_AGENT=

# Docker : port local sur lequel ton reverse proxy (nginx, Caddy…) retrouve l'appli. Change-le ici plutôt que dans docker-compose.yml.
ALTWP_HOST_PORT=8000

# Sans Docker seulement : dossier des données (sessions chiffrées, clé, dossiers des joueurs) et adresse d'écoute.
# NE PAS les décommenter avec Docker : l'image les règle déjà (/data, 0.0.0.0:8000) et ces valeurs les écraseraient.
# ALTWP_DATA=data
# ALTWP_HOST=0.0.0.0
# ALTWP_PORT=8000
